# =============================================================
# .env.example  ->  kopiere zu .env und fülle die Werte.
# .env steht in .gitignore und landet NIE im Repo.
#
# WICHTIG: Das aktuelle Frontend (frontend/index.html) braucht diese
# Datei NICHT. Es nutzt den PKCE-Flow und kommt ganz ohne Secret aus
# (nur die CLIENT_ID in frontend/config.js).
#
# Diese .env ist für das geplante Python-Backend (v1: Deezer-Proxy /
# ML-Ranker) vorbereitet — dort kann ein echtes Secret gebraucht werden.
# =============================================================

# --- Spotify (nur falls du später einen SERVER-seitigen Flow nutzt) ---
SPOTIFY_CLIENT_ID=deine_client_id
SPOTIFY_CLIENT_SECRET=dein_client_secret   # NUR im Backend! Nie ins Frontend, nie ins Repo.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5500/

# --- Backend ---
PORT=8000
